	measure 'Vl. Total Custo USD' = SUM(mart_platform_efficiency[vl_total_custo_usd])
		displayFolder: mart_platform_efficiency
		lineageTag: 4eec9a7c-69cc-442f-9acb-2e02a7ae1a20

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Nr. Anomalias Criticas' = 1
		formatString: 0
		displayFolder: mart_anomalies
		lineageTag: 4b5a6991-b6c9-475f-b12d-9cfa471fb656

	measure 'Nr. Jobs Criticos' =

			CALCULATE(
			    COUNT(mart_anomalies[id_job]),
			    mart_anomalies[nm_severidade] = "critical"
			)
		formatString: 0
		displayFolder: mart_anomalies
		lineageTag: 4b6b0793-d90d-4c51-9ad6-22bc78942ceb

	measure 'Ds. Domínio mais Caro' =

			VAR vMaiorData =
			CALCULATE(
			    MAX(mart_platform_efficiency[dt_execucao]),
			    ALLSELECTED(dim_calendario[Data])
			)
			VAR vTop =
			TOPN(
			    1,
			    ALLSELECTED(mart_platform_efficiency[nm_dominio]),
			    [Vl. Total Custo USD],
			    DESC

			)
			RETURN
			CALCULATE(
			    MAX(mart_platform_efficiency[nm_dominio]),
			    KEEPFILTERS(vTop),
			    mart_platform_efficiency[dt_execucao] = vMaiorData
			)
		displayFolder: mart_platform_efficiency
		lineageTag: 411dd544-aba2-479e-aa77-a224e8f037bb

	measure 'Vl. Total Custo USD (Últ. 30 dias)' =

			VAR vDtFiltro =
			CALCULATE(
			    MAX(mart_platform_efficiency[dt_execucao]),
			    ALLSELECTED(dim_calendario[Data])
			)
			RETURN
			CALCULATE(
			    [Vl. Total Custo USD],
			    KEEPFILTERS(dim_calendario[Data] >= vDtFiltro-30)
			)
		displayFolder: mart_platform_efficiency
		lineageTag: c89141ad-ba9f-4976-943c-f92e69db34a7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Vl. Total Custo USD (Últ. 7 dias)' =

			VAR vDtFiltro =
			CALCULATE(
			    MAX(mart_anomalies[dt_execucao]),
			    ALLSELECTED(dim_calendario[Data])
			)
			RETURN
			CALCULATE(
			    [Vl. Estimativa Custo USD],
			    KEEPFILTERS(dim_calendario[Data] >= vDtFiltro-7)
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: mart_anomalies
		lineageTag: cc3e6cad-d52c-4728-a964-36a33eb830d7

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Vl. Total Custo USD (Últ. 15 dias)' =

			VAR vDtFiltro =
			CALCULATE(
			    MAX(mart_platform_efficiency[dt_execucao]),
			    ALLSELECTED(dim_calendario[Data])
			)
			RETURN
			CALCULATE(
			    [Vl. Total Custo USD],
			    KEEPFILTERS(dim_calendario[Data] >= vDtFiltro-15)
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: mart_platform_efficiency
		lineageTag: c94dabe6-117b-4f95-beeb-c33012ff3e3a

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Vl. Média 7d Eficiência (Últ. 15 dias)' =

			VAR vDtFiltro =
			CALCULATE(
			    MAX(mart_platform_efficiency[dt_execucao]),
			    ALLSELECTED(dim_calendario[Data])
			)
			RETURN
			CALCULATE(
			    [Vl. Média 7d Eficiência],
			    KEEPFILTERS(dim_calendario[Data] >= vDtFiltro-15)
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: mart_platform_efficiency
		lineageTag: d5ba0b53-7bef-4f25-95df-644d6ae1cbd3

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Vl. Limite Superior Tendência' = [Vl. Média 7d Eficiência (Últ. 15 dias)] + (2 * [Vl. Desvio 7d Eficiência (Últ. 15 dias)])
		displayFolder: mart_platform_efficiency
		lineageTag: 835eb334-1e67-4d81-90bf-e29a97d9392f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Vl. Desvio 7d Eficiência (Últ. 15 dias)' =

			VAR vDtFiltro =
			CALCULATE(
			    MAX(mart_platform_efficiency[dt_execucao]),
			    ALLSELECTED(dim_calendario[Data])
			)
			RETURN
			CALCULATE(
			    [Vl. Desvio 7d Eficiência],
			    KEEPFILTERS(dim_calendario[Data] >= vDtFiltro-15)
			)
		formatString: 0
		displayFolder: mart_platform_efficiency
		lineageTag: d75211f3-ec22-4292-b6e7-dac06e419aa9

	measure 'Vl. Limite Inferior Tendência' = [Vl. Média 7d Eficiência (Últ. 15 dias)] - (2 * [Vl. Desvio 7d Eficiência (Últ. 15 dias)])
		displayFolder: mart_platform_efficiency
		lineageTag: 038a5bf2-112c-46d5-b7c9-527dc1d283f7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Vl. Amplitude Banda' = [Vl. Limite Superior Tendência] - [Vl. Limite Inferior Tendência]
		displayFolder: mart_platform_efficiency
		lineageTag: d97d9956-6633-4c1a-bd86-29fe5baba085

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Pc. Tendência Custo Card' =

			FORMAT([Pc. Tendência Custo %], "0.0%")
		displayFolder: mart_platform_efficiency
		lineageTag: 6cf261db-ddc5-4578-87eb-ae3b8e870bb1

	partition _measures = m
