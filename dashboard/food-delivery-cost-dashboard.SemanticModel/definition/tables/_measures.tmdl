		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Pc. Tendência Custo %' =

			DIVIDE(
			    ([Vl. Total Custo USD] - [Vl. Custo dia Anterior]),
			    [Vl. Custo dia Anterior]
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: mart_platform_efficiency
		lineageTag: 4bc9870e-558f-4d47-aeaa-7edd48c3be88

	measure 'Pc. Tendência Custo Score' = SUM(mart_platform_efficiency[nr_custo_trend_score])
		displayFolder: mart_platform_efficiency
		lineageTag: edd0aa93-f67a-4b5d-ba77-c361ea2409b0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Pc. Score Eficiência' = SUM(mart_platform_efficiency[nr_eficiencia_score])/100
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: mart_platform_efficiency
		lineageTag: 7f15968e-6f92-471c-96c3-6a5b50e8361d

	measure 'Nr. Média de Duração em Minutos' = SUM(mart_platform_efficiency[nr_medio_duracao_minutos])
		displayFolder: mart_platform_efficiency
		lineageTag: 99a1aeb5-09fd-43c5-9fff-9d0ce0b3d8f3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Nr. Jobs com Sucesso' = SUM(mart_platform_efficiency[nr_sucesso_jobs])
