		displayFolder: mart_platform_efficiency
		lineageTag: 6ecc1b93-1dd2-4d5d-8ae7-63aac0639444

	measure 'Pc. Taxa Sucesso %' =

			DIVIDE(
			    [Nr. Jobs com Sucesso],
			    [Nr. Total Jobs]
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: mart_platform_efficiency
		lineageTag: 94611031-c276-4975-b302-bf2678a8d7eb

	measure 'Nr. Total de Execuções em Minutos' = SUM(mart_platform_efficiency[nr_total_duracao_minutos])
